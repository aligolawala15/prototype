# ============================================================
# GF(256)
# ============================================================

def gf_mul(a: int, b: int) -> int:

    result = 0

    while b:

        if b & 1:
            result ^= a

        high = a & 0x80

        a = (a << 1) & 0xFF

        if high:
            a ^= 0x1D

        b >>= 1

    return result


def gf_pow(a: int, power: int) -> int:

    result = 1

    while power:

        if power & 1:
            result = gf_mul(result, a)

        a = gf_mul(a, a)

        power >>= 1

    return result


def gf_inv(a: int) -> int:

    if a == 0:
        raise ZeroDivisionError(
            "GF(256) zero has no inverse."
        )

    return gf_pow(a, 254)


def matrix_inverse(
    matrix: list[list[int]]
) -> list[list[int]]:

    n = len(matrix)

    augmented = []

    for r in range(n):

        augmented.append(
            list(matrix[r])
            + [
                1 if r == c else 0
                for c in range(n)
            ]
        )

    for col in range(n):

        pivot = None

        for row in range(col, n):

            if augmented[row][col] != 0:
                pivot = row
                break

        if pivot is None:
            raise ValueError(
                "Matrix is singular."
            )

        if pivot != col:

            augmented[col], augmented[pivot] = (
                augmented[pivot],
                augmented[col],
            )

        inverse_pivot = gf_inv(
            augmented[col][col]
        )

        augmented[col] = [
            gf_mul(value, inverse_pivot)
            for value in augmented[col]
        ]

        for row in range(n):

            if row == col:
                continue

            factor = augmented[row][col]

            if factor == 0:
                continue

            augmented[row] = [
                a ^ gf_mul(factor, b)
                for a, b in zip(
                    augmented[row],
                    augmented[col],
                )
            ]

    return [
        row[n:]
        for row in augmented
    ]


def matrix_vector_mul(
    matrix: list[list[int]],
    blocks: list[bytes],
) -> list[bytes]:

    result = []

    block_size = len(blocks[0])

    for row in matrix:

        output = bytearray(block_size)

        for coefficient, block in zip(
            row,
            blocks,
        ):

            if coefficient == 0:
                continue

            for i, value in enumerate(block):

                output[i] ^= gf_mul(
                    coefficient,
                    value,
                )

        result.append(bytes(output))

    return result


# ============================================================
# PARITY
# ============================================================

def parity_rows(
    parity_count: int,
) -> list[list[int]]:

    rows = []

    for p in range(parity_count):

        rows.append([
            gf_pow(
                data_index + 1,
                p + 1,
            )
            for data_index in range(DATA_PER_GROUP)
        ])

    return rows


def create_parity(
    data_blocks: list[bytes],
    parity_count: int,
) -> list[bytes]:

    if parity_count == 0:
        return []

    return matrix_vector_mul(
        parity_rows(parity_count),
        data_blocks,
    )


def recover_data(
    available: dict[int, bytes],
    parity_count: int,
) -> list[bytes]:

    if len(available) < DATA_PER_GROUP:
        raise ValueError(
            "Insufficient fragments."
        )

    selected_indices = sorted(
        available.keys()
    )[:DATA_PER_GROUP]

    matrix = []

    observed = []

    for index in selected_indices:

        if index < DATA_PER_GROUP:

            row = [
                1 if d == index else 0
                for d in range(DATA_PER_GROUP)
            ]

        else:

            parity_index = (
                index - DATA_PER_GROUP
            )

            row = [
                gf_pow(
                    d + 1,
                    parity_index + 1,
                )
                for d in range(DATA_PER_GROUP)
            ]

        matrix.append(row)

        observed.append(
            available[index]
        )

    inverse = matrix_inverse(matrix)

    return matrix_vector_mul(
        inverse,
        observed,
    )


# ============================================================
# DATA GENERATION
# ============================================================

def deterministic_data(
    size: int,
) -> bytes:

    pattern = (
        b"MOLECULAR-ADDRESS|"
        b"MILESTONE-15|"
        b"CONTROLLED-BENCHMARK|"
        b"DNA-STORAGE|"
        b"ADDRESS|"
        b"GENERATION|"
        b"INTEGRITY|"
        b"REDUNDANCY|"
        b"RECOVERY|"
        b"REPRODUCIBLE-DATA|"
    )

    data = bytearray()

    while len(data) < size:
        data.extend(pattern)

    return bytes(
        data[:size]
    )


# ============================================================
# FRAGMENTATION
# ============================================================

def fragment_data(
    data: bytes,
) -> list[bytes]:

    if len(data) % FRAGMENT_SIZE != 0:
        raise ValueError(
            "Dataset must be divisible by fragment size."
        )

    return [
        data[i:i + FRAGMENT_SIZE]
        for i in range(
            0,
            len(data),
            FRAGMENT_SIZE,
        )
    ]


# ============================================================
# SINGLE EXPERIMENT
# ============================================================

def run_experiment(
    data: bytes,
    parity_count: int,
) -> dict:

    source_hash = hashlib.sha256(
        data
    ).hexdigest()

    fragments = fragment_data(
        data
    )

    groups = [
        fragments[i:i + DATA_PER_GROUP]
        for i in range(
            0,
            len(fragments),
            DATA_PER_GROUP,
        )
    ]

    total_parity = 0

    start = time.perf_counter()

    archive = []

    for group in groups:

        parity = create_parity(
            group,
            parity_count,
        )

        total_parity += len(parity)

        archive.append({
            "data": group,
            "parity": parity,
        })

    encoding_seconds = (
        time.perf_counter() - start
    )

    if parity_count == 0:

        failure_test_exact = False
        recovery_seconds = 0.0

    else:

        start = time.perf_counter()

        # ----------------------------------------------------
        # Deliberately remove exactly parity_count data
        # fragments from ONE group.
        # ----------------------------------------------------

        target_group = archive[0]

        available = {}

        for i, block in enumerate(
            target_group["data"]
        ):

            if i >= parity_count:
                available[i] = block

        for p, block in enumerate(
            target_group["parity"]
        ):

            available[
                DATA_PER_GROUP + p
            ] = block

        recovered = recover_data(
            available,
            parity_count,
        )

        recovery_seconds = (
            time.perf_counter() - start
        )

        failure_test_exact = (
            recovered
            == target_group["data"]
        )

    overhead = (
        total_parity
        / len(fragments)
        * 100
    )

    result = {

        "dataset_bytes":
            len(data),

        "dataset_kb":
            len(data) / 1024,

        "fragment_size":
            FRAGMENT_SIZE,

        "data_fragments":
            len(fragments),

        "parity_fragments":
            total_parity,

        "parity_per_group":
            parity_count,

        "redundancy_overhead_percent":
            overhead,

        "source_sha256":
            source_hash,

        "encoding_seconds":
            encoding_seconds,

        "recovery_seconds":
            recovery_seconds,

        "boundary_test_failures":
            parity_count,

        "boundary_recovery_exact":
            failure_test_exact,

        "expected_boundary":
            parity_count,

        "boundary_valid":
            (
                failure_test_exact
                if parity_count > 0
                else True
            ),
    }

    return result


