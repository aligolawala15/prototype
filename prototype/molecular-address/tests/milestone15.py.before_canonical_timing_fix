# ------------------------------------------------------------
def run_benchmark() -> list[dict]:

    all_results = []

    for size in DATASET_SIZES:

        data = deterministic_data(
            size
        )

        for parity_count in PARITY_CONFIGURATIONS:

            result = run_experiment(
                data,
                parity_count,
            )

            all_results.append(
                result
            )

    return all_results


# ============================================================
# REPRODUCIBILITY TEST
# ============================================================

def reproducibility_test() -> dict:
    """
    Validate reproducibility using a canonical representation of the
    benchmark's scientific results.

    The benchmark itself is executed twice from the same deterministic
    random seed.

    Volatile execution metadata is excluded from the comparison.
    Scientific result fields are retained.
    """

    import hashlib
    import json
    import random

    # ============================================================
    # 1. DETERMINISTIC DATASET TEST
    # ============================================================

    data_a = deterministic_data(
        10 * 1024
    )

    data_b = deterministic_data(
        10 * 1024
    )

    dataset_sha_a = hashlib.sha256(
        data_a
    ).hexdigest()

    dataset_sha_b = hashlib.sha256(
        data_b
    ).hexdigest()

    same_dataset_sha256 = (
        dataset_sha_a == dataset_sha_b
    )

    # ============================================================
    # 2. RUN BENCHMARK A
    # ============================================================

    random.seed(RANDOM_SEED)

    benchmark_a = run_benchmark()

    # ============================================================
    # 3. RUN BENCHMARK B FROM IDENTICAL RNG STATE
    # ============================================================

    random.seed(RANDOM_SEED)

    benchmark_b = run_benchmark()

    # ============================================================
    # 4. CANONICALIZE RESULTS
    # ============================================================
    #
    # Keep fields that represent experimental results.
    #
    # Ignore execution-only metadata such as:
    # timestamp
    # run_timestamp
    # generated_at
    # execution_time
    # duration
    # run_id
    # UUID-like metadata
    #
    # The benchmark logic itself is NOT modified.
    # ============================================================

    volatile_keys = {
        "timestamp",
        "run_timestamp",
        "generated_at",
        "created_at",
        "updated_at",
        "execution_time",
        "elapsed_time",
        "duration",
        "runtime",
        "run_id",
        "execution_id",
        "uuid",
    }

    def canonicalize(value):

        if isinstance(value, dict):

            result = {}

            for key in sorted(
                value.keys(),
                key=lambda x: str(x)
            ):

                key_text = str(key)

                if key_text.lower() in {
                    str(k).lower()
                    for k in volatile_keys
                }:
                    continue

                result[key_text] = canonicalize(
                    value[key]
                )

            return result

        if isinstance(value, (list, tuple)):

            return [
                canonicalize(item)
                for item in value
            ]

        if isinstance(value, set):

            normalized = [
                canonicalize(item)
                for item in value
            ]

            return sorted(
                normalized,
                key=lambda x: json.dumps(
                    x,
                    sort_keys=True,
                    default=str
                )
            )

        if isinstance(value, float):

            return round(
                value,
                12
            )

        return value

    canonical_a = canonicalize(
        benchmark_a
    )

    canonical_b = canonicalize(
        benchmark_b
    )

    # ============================================================
    # 5. SERIALIZE CANONICAL RESULTS
    # ============================================================

    serialized_a = json.dumps(
        canonical_a,
        sort_keys=True,
        separators=(",", ":"),
        default=str,
    )

    serialized_b = json.dumps(
        canonical_b,
        sort_keys=True,
        separators=(",", ":"),
        default=str,
    )

    # ============================================================
    # 6. RESULT COMPARISON
    # ============================================================

    same_benchmark_structure = (
        type(benchmark_a)
        ==
        type(benchmark_b)
    )

    deterministic_results = (
        serialized_a
        ==
        serialized_b
    )

    # ============================================================
    # 7. EXTRA SCIENTIFIC STRUCTURE CHECK
    # ============================================================
    #
    # Confirm that the expected benchmark dimensions are identical.
    # This prevents a false PASS caused only by identical metadata.
    # ============================================================

    def extract_structure(value):

        if not isinstance(value, list):
            return value

        structure = []

        for row in value:

            if not isinstance(row, dict):
                structure.append(
                    canonicalize(row)
                )
                continue

            structure.append({
                "dataset_bytes":
                    row.get("dataset_bytes"),

                "parity_per_group":
                    row.get("parity_per_group"),

                "source_sha256":
                    row.get("source_sha256"),

                "expected_boundary":
                    row.get("expected_boundary"),

                "data_fragments":
                    row.get("data_fragments"),

                "parity_fragments":
                    row.get("parity_fragments"),

                "overhead_percent":
                    row.get("overhead_percent"),

                "exact":
                    row.get("exact"),
            })

        return structure

    structure_a = extract_structure(
        benchmark_a
    )

    structure_b = extract_structure(
        benchmark_b
    )

    same_scientific_structure = (
        structure_a
        ==
        structure_b
    )

    # Final reproducibility condition
    deterministic_results = (
        deterministic_results
        and
        same_scientific_structure
    )

    return {
        "same_dataset_sha256":
            same_dataset_sha256,

        "same_benchmark_structure":
            same_benchmark_structure
            and
            same_scientific_structure,

        "deterministic_results":
            deterministic_results,
    }

