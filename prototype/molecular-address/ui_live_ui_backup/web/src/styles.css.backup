@import url("https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400&family=Inter:wght@300;400;500&family=Playfair+Display:wght@400;500&display=swap");

:root{
  font-family:Inter,sans-serif;
  color:#eef7ff;
  background:#020611;
  font-synthesis:none;
}

*{box-sizing:border-box}

html,body,#root{
  margin:0;
  min-height:100%;
  width:100%;
}

body{
  overflow:hidden;
  background:#020611;
}

.cinema{
  height:100vh;
  min-height:600px;
  position:relative;
  overflow:hidden;
  background:
    radial-gradient(circle at 70% 48%,rgba(30,150,220,.18),transparent 28%),
    radial-gradient(circle at 25% 75%,rgba(10,90,150,.13),transparent 30%),
    #020611;
}

.ambient{
  position:absolute;
  border-radius:50%;
  filter:blur(90px);
  pointer-events:none;
}

.ambientOne{
  width:35vw;
  height:35vw;
  background:#006cff18;
  right:-10vw;
  top:15vh;
  animation:float 12s ease-in-out infinite;
}

.ambientTwo{
  width:25vw;
  height:25vw;
  background:#00d5c512;
  left:-8vw;
  bottom:-5vw;
  animation:float 16s ease-in-out infinite reverse;
}

@keyframes float{
  50%{transform:translate(40px,-25px) scale(1.1)}
}

.grain{
  position:absolute;
  inset:0;
  pointer-events:none;
  opacity:.045;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.6'/%3E%3C/svg%3E");
  z-index:5;
}

.nav{
  position:absolute;
  top:0;
  left:0;
  width:100%;
  height:86px;
  padding:0 5vw;
  display:flex;
  align-items:center;
  justify-content:space-between;
  z-index:10;
  border-bottom:1px solid rgba(255,255,255,.05);
  background:linear-gradient(#020611cc,transparent);
}

.logo{
  display:flex;
  gap:12px;
  align-items:center;
}

.logo>span{
  width:38px;
  height:38px;
  display:grid;
  place-items:center;
  border:1px solid rgba(100,200,255,.35);
  border-radius:50%;
  font:10px "DM Mono",monospace;
  color:#8edbff;
}

.logo b{
  display:block;
  font:10px "DM Mono",monospace;
  letter-spacing:.16em;
}

.logo small{
  display:block;
  color:#62778b;
  font:7px "DM Mono",monospace;
  letter-spacing:.14em;
  margin-top:4px;
}

.navCenter{
  position:absolute;
  left:50%;
  transform:translateX(-50%);
  font:8px "DM Mono",monospace;
  letter-spacing:.22em;
  color:#63788c;
}

.sceneNo{
  color:#70869b;
  font:9px "DM Mono",monospace;
}

main{
  width:100%;
  height:100%;
}

.scene{
  position:absolute;
  inset:0;
  display:grid;
  grid-template-columns:45% 55%;
  align-items:center;
  padding:90px 7vw 70px;
}

.copy{
  position:relative;
  z-index:3;
  max-width:650px;
}

.kicker{
  color:#70cfff;
  font:9px "DM Mono",monospace;
  letter-spacing:.23em;
  margin-bottom:27px;
}

h1{
  margin:0;
  font-family:"Playfair Display",serif;
  font-weight:400;
  font-size:clamp(52px,6.8vw,105px);
  line-height:.91;
  letter-spacing:-.055em;
}

h1 span{
  display:block;
}

p{
  max-width:440px;
  margin:30px 0 0;
  color:#7890a5;
  font-size:12px;
  line-height:1.8;
  font-weight:300;
}

.visual{
  height:70vh;
  position:relative;
  display:grid;
  place-items:center;
}

.dna{
  width:220px;
  height:520px;
  position:relative;
  transform:rotate(-4deg);
  filter:drop-shadow(0 0 30px rgba(70,190,255,.22));
  animation:helixFloat 6s ease-in-out infinite;
}

@keyframes helixFloat{
  50%{transform:rotate(4deg) translateY(-10px)}
}

.pair{
  position:absolute;
  width:100%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  color:#75d8ff;
  font:10px "DM Mono",monospace;
}

.pair i{
  height:1px;
  width:155px;
  background:linear-gradient(90deg,#3e9dff,#7fffea,#3e9dff);
  box-shadow:0 0 14px #54d8ff66;
}

.pair:nth-child(1){top:0}
.pair:nth-child(2){top:5.5%}
.pair:nth-child(3){top:11%}
.pair:nth-child(4){top:16.5%}
.pair:nth-child(5){top:22%}
.pair:nth-child(6){top:27.5%}
.pair:nth-child(7){top:33%}
.pair:nth-child(8){top:38.5%}
.pair:nth-child(9){top:44%}
.pair:nth-child(10){top:49.5%}
.pair:nth-child(11){top:55%}
.pair:nth-child(12){top:60.5%}
.pair:nth-child(13){top:66%}
.pair:nth-child(14){top:71.5%}
.pair:nth-child(15){top:77%}
.pair:nth-child(16){top:82.5%}
.pair:nth-child(17){top:88%}
.pair:nth-child(18){top:93.5%}

.binary{
  width:520px;
  color:#65d7ff;
  font:13px "DM Mono",monospace;
  line-height:2.5;
  text-align:center;
  opacity:.65;
}

.binary strong{
  display:block;
  margin-top:25px;
  font-size:45px;
  letter-spacing:.3em;
  color:#9eeeff;
  opacity:.9;
}

.dataStream{
  position:absolute;
  inset:0;
  overflow:hidden;
}

.dataStream span{
  position:absolute;
  color:#4da8d9;
  font:9px "DM Mono",monospace;
  white-space:nowrap;
}

.fragmentVisual{
  width:520px;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
}

.fragmentVisual div{
  padding:20px;
  border:1px solid #66cfff20;
  background:#66cfff06;
  backdrop-filter:blur(10px);
}

.fragmentVisual small,
.fragmentVisual b{
  display:block;
  font:8px "DM Mono",monospace;
}

.fragmentVisual small{
  color:#506d83;
  margin-bottom:15px;
}

.fragmentVisual b{
  color:#75dcff;
  letter-spacing:.14em;
}

.addressVisual{
  position:relative;
  display:flex;
  align-items:center;
  gap:40px;
}

.addressVisual .dna{
  width:160px;
  height:400px;
  transform:scale(.8);
}

.addressLines{
  display:flex;
  flex-direction:column;
  gap:25px;
  color:#6ed7ff;
  font:10px "DM Mono",monospace;
}

.redundancy{
  position:relative;
}

.ring{
  position:absolute;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%);
  border:1px solid #62d9ff33;
  border-radius:50%;
}

.ring1{
  width:430px;
  height:430px;
}

.ring2{
  width:620px;
  height:270px;
  transform:translate(-50%,-50%) rotate(-30deg);
}

.damagedDna .pair:nth-child(5) i,
.damagedDna .pair:nth-child(11) i,
.damagedDna .pair:nth-child(15) i{
  background:#ff6f7999;
  box-shadow:0 0 18px #ff526688;
}

.damagedDna .pair:nth-child(5) span,
.damagedDna .pair:nth-child(11) span,
.damagedDna .pair:nth-child(15) span{
  color:#ff737d;
}

.recoveryVisual{
  position:relative;
}

.recoveryParticles span{
  position:absolute;
  width:4px;
  height:4px;
  border-radius:50%;
  background:#67e7ca;
  left:50%;
  top:50%;
  animation:recover 3s ease-in-out infinite;
}

@keyframes recover{
  0%{transform:translate(var(--x),var(--y));opacity:0}
  40%,70%{opacity:1}
  100%{transform:translate(0,0);opacity:0}
}

.check{
  position:absolute;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%);
  width:90px;
  height:90px;
  border:1px solid #62e4c566;
  border-radius:50%;
  display:grid;
  place-items:center;
  color:#6ff1d2;
  font-size:42px;
  box-shadow:0 0 60px #48e0be22;
}

.progress{
  position:absolute;
  bottom:44px;
  left:7vw;
  width:86vw;
  height:1px;
  background:#ffffff10;
  z-index:10;
}

.progress div{
  height:100%;
  background:#75d7ff;
  box-shadow:0 0 12px #75d7ff;
}

footer{
  position:absolute;
  bottom:16px;
  left:7vw;
  right:7vw;
  display:flex;
  justify-content:space-between;
  color:#40576b;
  font:7px "DM Mono",monospace;
  letter-spacing:.15em;
  z-index:10;
}

@media(max-width:800px){
  .scene{
    grid-template-columns:1fr;
    padding:120px 8vw 80px;
  }

  .visual{
    position:absolute;
    inset:30% 0 0;
    opacity:.38;
    transform:scale(.7);
  }

  .copy{
    z-index:3;
  }

  .navCenter{
    display:none;
  }

  h1{
    font-size:55px;
  }

  footer span:last-child{
    display:none;
  }
}
